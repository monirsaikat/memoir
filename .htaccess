<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^storage/ - [F,L]
RewriteRule ^(?:config\.php(?:\..*)?|\.env|composer\.(?:json|lock)|.*\.(?:sql|bak|log))$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.|config\.php)">
    Require all denied
</FilesMatch>
