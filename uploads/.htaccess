<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
    RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
</IfModule>
<FilesMatch "(?i)(?:^\.|\.(?:php\d*|phtml|phar|cgi|pl|py|sh)(?:\.|$))">
    Require all denied
</FilesMatch>
